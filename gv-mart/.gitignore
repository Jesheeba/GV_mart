# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files — .env.local / .env.*.local already caught by *.local above;
# .env itself has no ".local" suffix so needs its own line. Never commit
# real Supabase keys/DB credentials — .env.example stays placeholder-only.
.env

# Supabase CLI local state (project-ref/pooler metadata, pgdelta cache) —
# machine-local, regenerated by `supabase link`/`db push`, not source.
supabase/.temp
supabase/.branches

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
