# Supabase browser client — anon key only.
# The service_role key must NEVER go here or in any client-side file;
# it lives only in Supabase Edge Function secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Maps (address-picker): the Google Maps API key is an Edge Function secret,
# NOT a client env var — see supabase/functions/.env.example. The `map-config`
# function hands it to the browser at runtime (unavoidable for the Maps
# JavaScript API to load); never add VITE_GOOGLE_MAPS_API_KEY here, since that
# would bake it into the static bundle and defeat the point of fetching it at
# runtime (it couldn't be rotated without a redeploy).
