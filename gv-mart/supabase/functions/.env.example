# Edge Function secrets for local dev — copy this file to `supabase/functions/.env`
# (gitignored by the root `.env` rule, which matches at any depth) and fill in real
# values. NEVER add VITE_ prefixes to these — that would bundle them into the
# client and defeat the point of proxying them through Edge Functions.
#
# Local dev: `supabase functions serve --env-file supabase/functions/.env`
# Production: `supabase secrets set --env-file supabase/functions/.env`
#   (or one at a time: `supabase secrets set GOOGLE_MAPS_API_KEY=...`)

# Google Maps Platform API key — https://console.cloud.google.com/google/maps-apis/credentials
# Used server-side by the `geocode` function (Places Autocomplete, Place
# Details, Geocoding, Directions) and handed to the browser at runtime by
# `map-config` so it can load the Maps JavaScript API (unavoidably
# client-visible — that's why it must be restricted by HTTP referrer in Cloud
# Console, not by secrecy). One key, four required APIs enabled on it: "Maps
# JavaScript API", "Places API" (Geocoding API is bundled under the same
# Places/Geocoding product family — enable "Geocoding API" too if the console
# lists it separately), and "Directions API" (added for v2.2 §6.6 live
# tracking — driving-distance lookups from a technician's live position to a
# job address). Billing must be enabled on the project for any of these to
# work, even within the free monthly credit.
GOOGLE_MAPS_API_KEY=

# WhatsApp webhook (Meta Cloud API inbound verification) — used by the
# `whatsapp-webhook` function's GET handshake and POST signature check.
# These are Meta-App-level secrets for receiving webhooks; independent of
# whichever provider ends up handling outbound sends (that choice is still
# open — see the WhatsApp build plan's transport decision).
#   WHATSAPP_VERIFY_TOKEN — any string you choose; enter the SAME value when
#     configuring the webhook URL in Meta App Dashboard > WhatsApp > Configuration.
#   WHATSAPP_APP_SECRET — from Meta App Dashboard > App Settings > Basic >
#     App Secret. Used to verify the X-Hub-Signature-256 header Meta signs
#     every webhook delivery with.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
